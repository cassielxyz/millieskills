{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Millie Fix Project Graph",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "files",
    "edges",
    "entry_points"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "role"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "language": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "imports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "imported_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "defines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "exports": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "generated": {
            "type": "boolean"
          },
          "vendor": {
            "type": "boolean"
          },
          "dynamic_reference_risk": {
            "enum": [
              "none",
              "low",
              "medium",
              "high",
              "unknown"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "from",
          "to"
        ],
        "properties": {
          "kind": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  }
}
